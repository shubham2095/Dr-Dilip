# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is gitignored and must never be committed.

# development locally, production on your host
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# Public address of the website (no trailing slash). Used for sitemap.xml and robots.txt.
SITE_URL=http://localhost:5000

# Mail server (SMTP) that SENDS the contact form emails.
# SMTP_SECURE is true for port 465, false for port 587.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Address that should RECEIVE contact form emails
CLIENT_EMAIL=
